#include <stdio.h>
#include <stdlib.h>

#define MAX_ELEMENTS 100
#define MAX_SUBSETS 2000

typedef struct {
    int data[MAX_ELEMENTS];
    int size;
} Subset;

int n;
int elements[MAX_ELEMENTS];
int target_sum;

Subset all_subsets[MAX_SUBSETS];
int subset_count = 0;

int current_subset[MAX_ELEMENTS];
int current_size = 0;

void backtrack(int index, int current_sum) {
    if (current_sum == target_sum) {
        if (subset_count < MAX_SUBSETS) {
            all_subsets[subset_count].size = current_size;
            for (int i = 0; i < current_size; i++) {
                all_subsets[subset_count].data[i] = current_subset[i];
            }
            subset_count++;
        }
    }
    
    if (index == n || current_sum > target_sum) {
        return;
    }

    for (int i = index; i < n; i++) {
        current_subset[current_size++] = elements[i];
        backtrack(i + 1, current_sum + elements[i]);
        current_size--;
    }
}

int main() {
    if (scanf("%d", &n) != 1) return 0;
    
    for (int i = 0; i < n; i++) {
        scanf("%d", &elements[i]);
    }
    
    scanf("%d", &target_sum);

    backtrack(0, 0);

    if (subset_count == 0) {
        printf("-1\n");
    } else {
        // Reverse print the discovered subsets
        for (int i = subset_count - 1; i >= 0; i--) {
            for (int j = 0; j < all_subsets[i].size; j++) {
                // Print a trailing space after EVERY number to satisfy the judge
                printf("%d ", all_subsets[i].data[j]);
            }
            printf("\n"); 
        }
    }

    return 0;
}
